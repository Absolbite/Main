function veltrolib:SetTransparency(v)
	v = math.clamp(tonumber(v) or 0, 0, 0.95)
	CurrentTransparency = v
	veltrolib.Save.Transparency = v
	SaveJson(veltrolib.Save)
	if _MainFrame then _MainFrame.Transparency = v end
	for d in Drawers do d.BackgroundTransparency = v end
