	end
end

function veltrolib:GetImageNames()
	local names = {}
	for n in veltrolib.Save.Images do names[#names + 1] = n end
	table.sort(names)
	return names
end

function veltrolib:SelectImage(name)
	local url = veltrolib.Save.Images[name]
	veltrolib.Save.SelectedImage = url and name or ""
	veltrolib:SetBackgroundImage(url or "")
end

function veltrolib:CreateImage(name, url)
	name, url = Trim(name), Trim(url)
	if name == "" then return false, "Image Name is empty" end
	if url == "" then return false, "Image URL is empty" end
	if name:lower() == "none" then return false, "Image Name is reserved" end
	veltrolib.Save.Images[name] = url
	SaveJson(veltrolib.Save)
	return true, name
end

function veltrolib:SetLoadMethod(m)
	if m ~= "Fast" and m ~= "Smooth" then return end
	veltrolib.Save.LoadMethod = m
	SaveJson(veltrolib.Save)
end

local function Defer(queue, build)
	local real, pending = nil, {}
	queue[#queue + 1] = function()
		real = build()
		for _, p in pending do real[p[1]](real, table.unpack(p, 2, p.n)) end
		pending = nil
	end
	return setmetatable({}, {__index = function(_, k)
		return function(_, ...)
			if real then return real[k](real, ...) end
			local args = table.pack(...)
			if type(k) == "string" and k:sub(1, 3) == "Add" then
				return Defer(queue, function() return real[k](real, table.unpack(args, 1, args.n)) end)
			end
			pending[#pending + 1] = table.pack(k, ...)
		end
	end})
end

local TabQueues, QueueWorker = {}, nil
local function PumpQueues()
	if QueueWorker then return end
	QueueWorker = task.spawn(function()
		task.wait()
		while true do
			local job
			for _, q in TabQueues do
				if q[1] then job = table.remove(q, 1) break end
			end
			if not job then break end
			job()
			task.wait()
		end
		QueueWorker = nil
	end)
end

