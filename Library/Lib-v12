local CanFS = makefolder and writefile and isfolder and true or false

local function EnsureFolders()
	if not CanFS then return end
	for _, f in {SaveRoot, SaveFolder, ImgCache} do
		if not isfolder(f) then makefolder(f) end
	end
end
local function SaveJson(save)
	if not CanFS then return end
	EnsureFolders()
	writefile(SaveFile, HttpService:JSONEncode(save))
end

local ImageAssetCache = {}
function veltrolib.FetchHttpImage(url)
	if ImageAssetCache[url] then return ImageAssetCache[url] end
	if not CanFS then return url end
	EnsureFolders()
	local path = ImgCache .. "/" .. url:gsub("[^%w%-_]", "_"):sub(1, 60) .. "." .. (url:match("%.(%w+)%??[^%.]*$") or "png")
	if not isfile(path) then
		local ok, body = pcall(game.HttpGet, game, url)
		if not ok or not body then return url end
		pcall(writefile, path, body)
	end
	if isfile(path) then
		local ok, asset = pcall(getcustomasset, path)
		if ok then ImageAssetCache[url] = asset return asset end
	end
	return url
end

