			end

			for i, v in DOptions do AddOption(i, v) end
			UpdateLabel()
			Fire()

			SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
				Query = SearchBox.Text:lower()
				local n = 0
				for _, Opt in Order do
					local m = Query == "" or Opt.lower:find(Query, 1, true) ~= nil
					if Opt.visible ~= m then Opt.visible = m Opt.nodes[1].Visible = m end
					if m then n += 1 end
				end
				VisibleCount = n
				Resize()
			end)
			Button.Activated:Connect(Toggle)
			NoClick.MouseButton1Down:Connect(function()
				local dp, ds = DropFrame.AbsolutePosition, DropFrame.AbsoluteSize
				local mx, my = PlayerMouse.X, PlayerMouse.Y
				if mx >= dp.X and mx <= dp.X + ds.X and my >= dp.Y and my <= dp.Y + ds.Y then return end
				Disable()
			end)
			MainFrame:GetPropertyChangedSignal("Visible"):Connect(Disable)
			for _, sig in {"AbsolutePosition", "AbsoluteSize"} do
				Containers:GetPropertyChangedSignal(sig):Connect(function() if NoClick.Visible and not WaitDrop then CalcPos() end end)
			end

			local Dropdown = {}
			function Dropdown:Visible(b) Funcs.ToggleVisible(Button, b) end
			function Dropdown:Destroy() Button:Destroy() NoClick:Destroy() end
			function Dropdown:Callback(f) Funcs.InsertCallback(Callback, f)(Multi and SelectedValues or Selected) end
			function Dropdown:Add(...)
				local New = {...}
				if type(New[1]) == "table" then New = New[1] end
				for _, n in New do AddOption(n, n) end
			end
			function Dropdown:Remove(o) RemoveOption(type(o) == "number" and Order[o] or Options[tostring(o)]) end
			function Dropdown:Select(o)
				local Mode = {
					multiList = function()
						local Want = {}
						table.clear(SelectedValues)
						for _, v in o do
							local n = tostring(v)
							if Options[n] and not Want[n] then Want[n] = true SelectedValues[#SelectedValues + 1] = n end
						end
						for _, Opt in Order do SetState(Opt, Want[Opt.Name] == true) end
					end,
					multiOne = function()
						local Opt = Options[tostring(o)]
						if not Opt then return end
						local On = not Opt.on
						if On then SelectedValues[#SelectedValues + 1] = Opt.Name else RemoveValue(Opt.Name) end
						SetState(Opt, On)
					end,
					single = function()
						local Opt = type(o) == "number" and Order[o] or Options[tostring(o)]
						if not Opt then return end
						if CurrentOpt and CurrentOpt ~= Opt then SetState(CurrentOpt, false) end
						CurrentOpt, Selected = Opt, Opt.Value
						SetState(Opt, true)
					end
				}
				Mode[Multi and (type(o) == "table" and "multiList" or "multiOne") or "single"]()
				UpdateLabel()
				SetFlag(Flag, Multi and SelectedValues or tostring(Selected or ""))
			end
			function Dropdown:Set(V, Clear)
				local h = {table = function() AddNew(V, not Clear) end, ["function"] = function() Funcs.SetCallback(Callback, V) end}
				local f = h[type(V)]
				if f then f() end
			end
			return Dropdown
		end

		function Tab:AddSlider(C)
			local Min = C[2] or C.MinValue or C.Min or 0
			local Max = C[3] or C.MaxValue or C.Max or 100
			local Inc = C[4] or C.Increase or 1
			local Callback = Funcs.GetCallback(C, 6)
			local Flag = C[7] or C.Flag or false
			local Default = C[5] or C.Default or Min
			if CheckFlag(Flag) then Default = GetFlag(Flag) end
			Default = math.clamp(tonumber(Default) or Min, Min, Max)

			local Button, LabelFunc = ButtonFrame(Container, C[1] or C.Name or C.Title or "Slider!", C.Desc or C.Description or "", UD2(1, -180))
			local RM, IW, GAP = 10, 38, 8
			local SW = 150 - IW - GAP

			local Holder = Create("TextButton", Button, {
				Size = UD2(0, SW, 1, 0), Position = UD2(1, -RM, 0, 0), AnchorPoint = Vector2.new(1, 0), AutoButtonColor = false, Text = "", BackgroundTransparency = 1
			})
			local Bar = InsertTheme(Create("Frame", Holder, {
				BackgroundColor3 = Theme["Color Theme"], BackgroundTransparency = 0.85, Size = UD2(1, 0, 0, 6), Position = UD2(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5)
			}), "Theme")
			Make("Corner", Bar, UD(0.5, 0))
			local Indicator = InsertTheme(Create("Frame", Bar, {BackgroundColor3 = Theme["Color Theme"], Size = UDim2.fromScale(0, 1), BorderSizePixel = 0}), "Theme")
			Make("Corner", Indicator, UD(0.5, 0))
			local Icon = InsertTheme(Create("Frame", Bar, {
				Size = UD2(0, 12, 0, 12), BackgroundColor3 = Theme["Color Theme"], Position = UDim2.fromScale(0, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 0.2
			}), "Theme")
			Make("Corner", Icon, UD(0.5, 0))
			local InputHolder = InsertTheme(Create("Frame", Button, {
				Size = UD2(0, IW, 0, 18), Position = UD2(1, -(RM + SW + GAP), 0.5), AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = Theme["Color Theme"], BackgroundTransparency = 0.85
			}), "Theme")
			Make("Corner", InputHolder, UD(0, 4))
			local ValueInput = InsertTheme(Create("TextBox", InputHolder, {
				Size = UD2(1, -6, 0.85, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UD2(0.5, 0, 0.5, 0), BackgroundTransparency = 1, Font = Font.FredokaOne,
				TextScaled = true, TextColor3 = Theme["Color Text"], Text = tostring(Default), ClearTextOnFocus = true, TextXAlignment = "Center"
			}), "Text")

			local cur, focused = Default, false
			local Decimals = #(tostring(Inc):match("%.(%d+)") or "")
			local factor = 10 ^ Decimals
			local function Snap(v) return math.clamp(math.floor(math.floor(v / Inc + 0.5) * Inc * factor + 0.5) / factor, Min, Max) end
			local function Fmt(v) return Decimals == 0 and tostring(math.floor(v)) or string.format("%." .. Decimals .. "f", v) end
			local function Visual(v)
				local s = Max == Min and 0 or math.clamp((v - Min) / (Max - Min), 0, 1)
				Icon.Position, Indicator.Size = UD2(s, 0, 0.5, 0), UDim2.fromScale(s, 1)
			end
			local function SetSlider(v, skip)
				if type(v) ~= "number" then return end
				v = Snap(v)
				cur = v
				Visual(v)
				if not focused then ValueInput.Text = Fmt(v) end
				if not skip then
					SetFlag(Flag, v)
					Funcs.FireCallback(Callback, v)
				end
			end

			Holder.MouseButton1Down:Connect(function()
				Container.ScrollingEnabled = false
				while Held() do
					task.wait()
					SetSlider(Snap(math.clamp((PlayerMouse.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1) * (Max - Min) + Min))
				end
				Container.ScrollingEnabled = true
			end)
			ValueInput:GetPropertyChangedSignal("Text"):Connect(function()
				local clean = ValueInput.Text:gsub("[^%d%.%-]", "")
				if clean ~= ValueInput.Text then ValueInput.Text = clean end
			end)
			ValueInput.Focused:Connect(function() focused = true Container.ScrollingEnabled = false end)
			ValueInput.FocusLost:Connect(function()
				focused = false
				Container.ScrollingEnabled = true
				local n = tonumber(ValueInput.Text)
				if not n then ValueInput.Text = Fmt(cur) return end
				local cl = math.clamp(n, Min, Max)
				cur = cl
				Visual(cl)
				if cl ~= n then ValueInput.Text = Fmt(cl) end
				SetFlag(Flag, cl)
				Funcs.FireCallback(Callback, cl)
			end)

			SetSlider(Default, not CheckFlag(Flag))
			SetFlag(Flag, Default)

			local Slider = {}
			function Slider:Set(V1, V2)
				if V1 and V2 then LabelFunc:SetTitle(V1) LabelFunc:SetDesc(V2) return end
				local h = {
					string = function() LabelFunc:SetTitle(V1) end,
					["function"] = function() Funcs.SetCallback(Callback, V1) end,
					number = function() SetSlider(V1) end
				}
				local f = h[type(V1)]
				if f then f() end
			end
			function Slider:Callback(f) Funcs.InsertCallback(Callback, f)(cur) end
			function Slider:Visible(b) Funcs.ToggleVisible(Button, b) end
			function Slider:Destroy() Button:Destroy() end
			return Slider
		end

		function Tab:AddTextBox(C)
			local Default = C[2] or C.Default or ""
			local ClearText = C[3] or C.ClearText or false
			local Callback = Funcs.GetCallback(C, 4)
			local Placeholder = C[5] or C.PlaceholderText or "Input"
			local Flag = C.Flag or C[6] or false
			if CheckFlag(Flag) and type(GetFlag(Flag)) == "string" then Default = GetFlag(Flag) end
			if type(Default) ~= "string" then Default = "" end

			local Button = ButtonFrame(Container, C[1] or C.Name or C.Title or "Text Box", C.Desc or C.Description or "", UD2(1, -38))
			local Sel = InsertTheme(Create("Frame", Button, {
				Size = UD2(0, 150, 0, 18), Position = UD2(1, -10, 0.5), AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = Theme["Color Theme"], BackgroundTransparency = 0.85
			}), "Theme")
			Make("Corner", Sel, UD(0, 4))
			local Input = InsertTheme(Create("TextBox", Sel, {
				Size = UD2(0.85, 0, 0.85, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UD2(0.5, 0, 0.5, 0), BackgroundTransparency = 1, Font = Font.GothamBold,
				TextScaled = true, TextColor3 = Theme["Color Text"], ClearTextOnFocus = ClearText, PlaceholderText = Placeholder, Text = Default
			}), "Text")

			local TextBox = {OnChanging = false}
			Input.FocusLost:Connect(function()
				local t = Input.Text
				if t:gsub(" ", ""):len() == 0 then return end
				if TextBox.OnChanging then t = TextBox.OnChanging(t) or t end
				Funcs.FireCallback(Callback, t)
				Input.Text = t
				SetFlag(Flag, t)
			end)
			if Default ~= "" then
				task.defer(function()
					Funcs.FireCallback(Callback, Default)
					SetFlag(Flag, Default)
				end)
			end
			function TextBox:Visible(b) Funcs.ToggleVisible(Button, b) end
			function TextBox:Destroy() Button:Destroy() end
			function TextBox:Set(V)
				local h = {
					string = function() Input.Text = V SetFlag(Flag, V) Funcs.FireCallback(Callback, V) end,
					["function"] = function() Funcs.SetCallback(Callback, V) end
				}
				local f = h[type(V)]
				if f then f() end
			end
			return TextBox
		end

		function Tab:AddDiscordInvite(C)
			local InvTitle = C[1] or C.Name or C.Title or "Discord"
			local Desc = C.Desc or C.Description or ""
			local Logo = C[2] or C.Logo or ""
			local Invite = C[3] or C.Invite or ""
			local hasLogo = type(Logo) == "string" and Logo:gsub(" ", ""):len() > 0
			if hasLogo then Logo = veltrolib:GetIcon(Logo) end

			local Card = InsertTheme(Create("Frame", Container, {Size = UD2(1, 0, 0, 80), BackgroundColor3 = Theme["Color Theme"], BackgroundTransparency = ElementT(), Name = "Option"}), "ElementBG")
			Make("Corner", Card, UD(0, 3))
			if hasLogo then
				InsertTheme(Create("ImageLabel", Card, {
					Size = UD2(0, 34, 0, 34), Position = UD2(0, 8, 0, 8), BackgroundTransparency = 1, Image = Logo, ImageColor3 = Color3.new(1, 1, 1),
					ImageTransparency = ElementT(), ScaleType = Enum.ScaleType.Crop, Name = "Logo"
				}, {Create("UICorner", {CornerRadius = UD(0, 5)})}), "ElementImg")
			end
			local x = hasLogo and 50 or 10
			InsertTheme(Create("TextLabel", Card, {
				Font = Font.GothamBold, TextColor3 = Theme["Color Text"], Size = UD2(1, -(x + 10), 0, 14), Position = UD2(0, x, 0, 9), BackgroundTransparency = 1,
				TextTruncate = "AtEnd", TextSize = 11, TextXAlignment = "Left", Text = InvTitle
			}), "Text")
			InsertTheme(Create("TextLabel", Card, {
				Font = Font.Gotham, TextColor3 = Theme["Color Dark Text"], Size = UD2(1, -(x + 10), 0, 22), Position = UD2(0, x, 0, 24), BackgroundTransparency = 1,
				TextWrapped = true, TextTruncate = "None", TextSize = 9, TextXAlignment = "Left", TextYAlignment = "Top", Text = Desc
			}), "DarkText")
			local Join = InsertTheme(Create("TextButton", Card, {
				Size = UD2(1, -16, 0, 18), Position = UD2(0, 8, 1, -26), Text = "Join", Font = Font.GothamBold, TextSize = 10, TextColor3 = Theme["Color Text"],
				BackgroundColor3 = Theme["Color Theme"], BackgroundTransparency = 0.65, AutoButtonColor = false
			}), "Theme")
			Make("Corner", Join, UD(0, 5))

			local Delay
			Join.Activated:Connect(function()
				if Delay then return end
				Delay = true
				setclipboard(Invite)
				SetProps(Join, {Text = "Copied!", BackgroundColor3 = C3(80, 80, 80), BackgroundTransparency = 0, TextColor3 = C3(150, 150, 150)})
				task.wait(3)
				SetProps(Join, {Text = "Join", BackgroundColor3 = Theme["Color Theme"], BackgroundTransparency = 0.65, TextColor3 = Theme["Color Text"]})
				Delay = false
			end)

			local D = {}
			function D:Visible(b) Funcs.ToggleVisible(Card, b) end
			function D:Destroy() Card:Destroy() end
			return D
		end

		if Smooth and not IsFirst then
			local Q = {}
			TabQueues[#TabQueues + 1] = Q
			PumpQueues()
			return setmetatable({Cont = Container}, {__index = function(_, k)
				local v = Tab[k]
				if type(k) == "string" and k:sub(1, 3) == "Add" then
					return function(_, ...)
						local a = table.pack(...)
						PumpQueues()
						return Defer(Q, function() return v(Tab, table.unpack(a, 1, a.n)) end)
					end
				end
				return v
			end})
		end
		return Tab
	end

	CloseButton.Activated:Connect(Window.CloseBtn)
	MinimizeButton.Activated:Connect(Window.MinimizeBtn)
	return Window
end

return veltrolib
