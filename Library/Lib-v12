local Funcs = {}
function Funcs.InsertCallback(tab, f) if type(f) == "function" then tab[#tab + 1] = f end return f end
function Funcs.SetCallback(tab, f) if type(f) == "function" then table.clear(tab) tab[1] = f end end
function Funcs.FireCallback(tab, ...) for _, v in tab do if type(v) == "function" then task.spawn(v, ...) end end end
function Funcs.ToggleVisible(o, b) if b == nil then b = not o.Visible end o.Visible = b end
function Funcs.ToggleParent(o, b, p)
	if b == nil then b = not o.Parent end
	o.Parent = b and p or nil
end
function Funcs.GetCallback(Cfg, idx)
	local f = Cfg[idx] or Cfg.Callback or function() end
	if type(f) == "table" then return {function(v) f[1][f[2]] = v end} end
	return {f}
end

local Connection, Connections = veltrolib.Connection, {}
for _, n in {"FlagsChanged", "ThemeChanged", "FileSaved", "ThemeChanging", "OptionAdded"} do
	local list, c = {}, {Name = n}
	Connection[n], Connections[n] = c, list
	local function wrap(f)
		local o = {Function = f, Connected = true}
		function o:Disconnect()
			if self.Connected then
				local i = table.find(list, self.Function)
				if i then table.remove(list, i) end
				self.Connected = false
			end
		end
		function o:Fire(...) if self.Connected then task.spawn(self.Function, ...) end end
		return o
	end
	function c:Connect(f) if type(f) == "function" then list[#list + 1] = f return wrap(f) end end
	function c:Once(f)
		if type(f) ~= "function" then return end
		local o
		local g = function(...) task.spawn(f, ...) o:Disconnect() end
		list[#list + 1] = g
		o = wrap(g)
		return o
	end
end
function Connection:FireConnection(n, ...)
	for _, f in table.clone(Connections[type(n) == "string" and n or n.Name]) do task.spawn(f, ...) end
end

