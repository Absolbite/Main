function veltrolib:SetScale(s)
	UIScale = ViewportSize.Y / math.clamp(s, 300, 2000)
	ScreenGui.Scale.Scale = UIScale
end

function veltrolib:SetBackgroundImage(raw)
	local id = Trim(raw)
	if id ~= "" then id = veltrolib:GetIcon(id) end
