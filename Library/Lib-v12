	}), "ElementBG")
	Make("Corner", Frame, UD(0, 3))

	local TitleL = InsertTheme(Create("TextLabel", Frame, {
		Font = Font.GothamMedium, TextColor3 = Theme["Color Text"], Size = HolderSize, Position = UD2(0, 10, 0, 7),
		BackgroundTransparency = 1, TextTruncate = "AtEnd", TextSize = 10, TextXAlignment = "Left", TextYAlignment = "Center", Text = ""
	}), "Text")
	local DescL = InsertTheme(Create("TextLabel", Frame, {
		Font = Font.Gotham, TextColor3 = Theme["Color Text"], Size = UD2(1, -20, 0, 0), Position = UD2(0, 10, 0, 21),
		BackgroundTransparency = 1, TextWrapped = true, TextSize = 9, LineHeight = 1.25, TextXAlignment = "Left", TextYAlignment = "Top", Text = "", Visible = false
	}), "Text")

	local function Center(on)
		TitleL.Position = on and UD2(0, 10, 0.5, 0) or UD2(0, 10, 0, 9)
		TitleL.AnchorPoint = on and Vector2.new(0, 0.5) or Vector2.zero
	end
	if not hasDesc then Center(true) end

	local Label, resizeConn = {}
	function Label:SetTitle(v)
		if type(v) == "string" and v:gsub(" ", ""):len() > 0 then
			TitleL.RichText = NeedsRichText(v)
			TitleL.Text = v
		end
	end
	local function Fit()
		local plain = DescL.Text:gsub("<[^<>]->", "")
		if plain == "" then plain = " " end
		local w = (Frame.AbsoluteSize.X - 20) / UIScale
		if w <= 0 then w = 200 end
		local h = TextService:GetTextSize(plain, DescL.TextSize, DescL.Font, Vector2.new(w, math.huge)).Y * DescL.LineHeight
		DescL.Size = UD2(1, -20, 0, h)
		Frame.Size = UD2(1, 0, 0, 29 + h)
	end
	function Label:SetDesc(v)
		if resizeConn then resizeConn:Disconnect() resizeConn = nil end
		if type(v) == "string" and v:gsub(" ", ""):len() > 0 then
			DescL.Visible, DescL.RichText, DescL.Text = true, NeedsRichText(v), v
			Center(false)
			Fit()
			resizeConn = Frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(Fit)
		else
			DescL.Visible, DescL.Text = false, ""
			Center(true)
			Frame.Size = UD2(1, 0, 0, H)
		end
	end
	Label:SetTitle(Title)
	Label:SetDesc(Description)
	return Frame, Label
end

function veltrolib:GetIcon(index)
	if type(index) ~= "string" or #index == 0 then return index end
	if index:find("^https?://") then return self.FetchHttpImage(index) end
	if index:find("rbxassetid://", 1, true) then return index end
	index = index:lower():gsub("lucide", ""):gsub("-", "")
	if Icons[index] then return Icons[index] end
	for Name, Icon in Icons do
		if Name:find(index, 1, true) then return Icon end
	end
	return index
end

function veltrolib:SetTheme(NewTheme)
	if not Themes[NewTheme] then return end
	veltrolib.Save.Theme = NewTheme
	SaveJson(veltrolib.Save)
	Theme = Themes[NewTheme]
	Connection:FireConnection("ThemeChanged", NewTheme)
	for inst, typ in Themed do
		local f = ThemeApply[typ]
		if f then f(inst) end
	end
end

