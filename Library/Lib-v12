local TweenCache = {}
local function CreateTween(Cfg)
	local inst, prop, val = Cfg[1] or Cfg.Instance, Cfg[2] or Cfg.Prop, Cfg[3] or Cfg.NewVal
	local time = Cfg[4] or Cfg.Time or 0.5
	local info = TweenCache[time]
	if not info then info = TweenInfo.new(time, Enum.EasingStyle.Quint) TweenCache[time] = info end
	local tw = TweenService:Create(inst, info, {[prop] = val})
	tw:Play()
	if Cfg[5] or Cfg.wait then tw.Completed:Wait() end
	return tw
end

local function IsPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function Held() return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end

local function MakeDrag(Instance)
	Instance.Active, Instance.AutoButtonColor = true, false
	local DragStart, StartPos, InputOn
	Instance.MouseButton1Down:Connect(function() InputOn = true end)
	Instance.InputBegan:Connect(function(Input)
		if not IsPress(Input) then return end
		StartPos, DragStart = Instance.Position, Input.Position
		while Held() do
			RunService.Heartbeat:Wait()
			if InputOn then
				local d = Input.Position - DragStart
				CreateTween({Instance, "Position", UD2(StartPos.X.Scale, StartPos.X.Offset + d.X / UIScale, StartPos.Y.Scale, StartPos.Y.Offset + d.Y / UIScale), 0.35})
			end
		end
		InputOn = false
	end)
	return Instance
end

